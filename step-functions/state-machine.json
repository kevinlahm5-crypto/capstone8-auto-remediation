{
  "StartAt": "Evaluate",
  "States": {
    "Evaluate": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:264787847442:function:CapstoneEvaluator",
      "ResultPath": "$.evaluationResult",
      "Next": "Remediate"
    },
    "Remediate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:startAutomationExecution",
      "Parameters": {
        "DocumentName": "AWS-DisablePublicAccessForSecurityGroup",
        "Parameters": {
          "GroupId.$": "States.Array($.SecurityGroupId)"
        }
      },
      "End": true
    }
  }
}